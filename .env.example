# Server
PORT=3000
APP_TIME_ZONE=Asia/Kolkata
STATE_FILE=data/state.json

# Google Sheets
# Paste only the ID between /d/ and /edit in the Sheet URL.
SPREADSHEET_ID=
# Absolute path is safest on Windows. This file must never be committed.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
TIMER_SESSIONS_TAB=Timer Sessions
DAILY_DASHBOARD_TAB=Daily Dashboard
# "validate" checks existing tabs/headers. "create-or-repair" may add the two app tabs and formulas.
SHEETS_SETUP_MODE=validate

# Reserved for the GitHub/LeetCode phases.
EVIDENCE_BUFFER_MINUTES=10
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_USERNAME=
LEETCODE_USERNAME=
