# ─── Database ──────────────────────────────────────────────────────────────
# Get this from Neon (https://neon.tech) or Supabase (https://supabase.com)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ─── Authentication ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-string"
# Set to your production URL after deploying (e.g., https://my-tracker.netlify.app)
NEXTAUTH_URL="http://localhost:3000"
# Your login password — pick something memorable
AUTH_PASSWORD="change-me"

# ─── Application ───────────────────────────────────────────────────────────
APP_TIME_ZONE="Asia/Kolkata"

# ─── Optional: Google Sheets Sync ──────────────────────────────────────────
# Paste the JSON content of your service account key (not a file path)
# GOOGLE_SERVICE_ACCOUNT_KEY='{...}'
# SPREADSHEET_ID=
# TIMER_SESSIONS_TAB="Timer Sessions"
# DAILY_DASHBOARD_TAB="Daily Dashboard"
